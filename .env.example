POSTGRES_DB=vaulta
POSTGRES_USER=vaulta
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8080
JWT_SECRET=
JWT_ISSUER=vaulta
JWT_AUDIENCE=vaulta-app
MINIO_ROOT_USER=vaulta-minio
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ASSETS_BUCKET=vaulta-assets
# Endpoint reached by the client: use http://10.0.2.2:9000 for Android Emulator.
# Adjust the port if MINIO_API_PORT changes. Keep API-to-storage traffic on minio:9000.
ASSETS_PUBLIC_SERVICE_URL=http://localhost:9000
# Asaas sandbox credentials; configure securely, never commit real values.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Keep disabled until provider setup and seller identity review are ready.
PAYOUTS_TRANSFERS_ENABLED=false
REFUNDS_REQUESTS_ENABLED=false
PAYOUTS_IDENTITY_REVIEWER_USER_ID=
# Server only. Development uses OpenAI when a key is available, otherwise OCR.
OPENAI_API_KEY=
SCANNER_RECOGNITION_PROVIDER=openai
