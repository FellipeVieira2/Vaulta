[Unit]
Description=Vaulta incremental official-artwork embeddings
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vaulta
ExecStart=/usr/bin/bash /opt/vaulta/scripts/vision-index-follow.sh
Restart=always
RestartSec=30
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
