[Unit]
Description=Vaulta PostgreSQL compressed backup to private S3
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/opt/vaulta
ExecStart=/opt/vaulta/scripts/backup-postgres.sh
UMask=0077
Nice=10
TimeoutStartSec=30min
