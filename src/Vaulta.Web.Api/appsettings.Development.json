{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Scanner": {
    "Nova": {
      "Enabled": false,
      "Region": "us-east-1",
      "ModelId": "amazon.nova-lite-v1:0",
      "TimeoutSeconds": 15,
      "MaxTokens": 768,
      "RetryCount": 1,
      "RetryDelayMilliseconds": 200,
      "MaxConcurrency": 2
    },
    "Recognition": {
      "Provider": "openai",
      "FallbackProvider": "ocr"
    },
    "OpenAI": {
      "Enabled": true,
      "Model": "gpt-6-luna",
      "TimeoutSeconds": 15,
      "MaxConcurrency": 4,
      "RetryCount": 1,
      "RetryDelayMilliseconds": 200,
      "ImageDetail": "high",
      "MaxOutputTokens": 1280,
      "MaxImageEdge": 2048,
      "JpegQuality": 90
    }
  }
}
