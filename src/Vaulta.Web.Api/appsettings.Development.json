{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Scanner": {
    "Nova": {
      "Enabled": true,
      "Region": "us-east-1",
      "ModelId": "amazon.nova-lite-v1:0",
      "TimeoutSeconds": 15,
      "MaxTokens": 768,
      "RetryCount": 1,
      "RetryDelayMilliseconds": 200,
      "MaxConcurrency": 2
    }
  }
}
