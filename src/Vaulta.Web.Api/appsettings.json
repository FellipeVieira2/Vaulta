{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {},
  "Asaas": {
    "BaseUrl": "https://api-sandbox.asaas.com/"
  },
  "Payouts": {
    "WorkerEnabled": true,
    "TransfersEnabled": false,
    "IdentityReviewerUserIds": []
  },
  "Refunds": {
    "WorkerEnabled": true,
    "RequestsEnabled": false
  },
  "Jwt": {
    "Issuer": "vaulta-api",
    "Audience": "vaulta-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Catalog": {
    "Providers": {
      "TcgDex": {
        "BaseAddress": "https://api.tcgdex.net/v2/",
        "Language": "en",
        "Timeout": 30,
        "MaxConcurrency": 4,
        "RetryCount": 3,
        "MaxRetryDelaySeconds": 60
      }
    }
  }
}
