{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "Providers": {
      "TcgDex": {
        "BaseAddress": "https://api.tcgdex.net/v2/",
        "Language": "en",
        "Timeout": 30,
        "MaxConcurrency": 4,
        "RetryCount": 3,
        "MaxRetryDelaySeconds": 60
      }
    }
  }
}
