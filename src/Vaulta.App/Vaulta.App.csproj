<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Vaulta.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>Vaulta</ApplicationTitle>
		<ApplicationId>com.vaulta.app</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<UserSecretsId>vaulta-maui-app-dev</UserSecretsId>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!-- Android signing configuration for Play Store publication (only when keystore password is provided) -->
		<AndroidKeyStore Condition="'$(Configuration)' == 'Release' AND '$(VAULTA_KEYSTORE_PASS)' != ''">true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="'$(Configuration)' == 'Release' AND '$(VAULTA_KEYSTORE_PASS)' != ''">vaulta-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(Configuration)' == 'Release' AND '$(VAULTA_KEYSTORE_PASS)' != ''">vaulta</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass Condition="'$(Configuration)' == 'Release' AND '$(VAULTA_KEYSTORE_PASS)' != ''">$(VAULTA_KEYSTORE_PASS)</AndroidSigningKeyPass>
		<AndroidSigningStorePass Condition="'$(Configuration)' == 'Release' AND '$(VAULTA_KEYSTORE_PASS)' != ''">$(VAULTA_KEYSTORE_PASS)</AndroidSigningStorePass>

		<!-- Target SDK for Play Store compliance (API 36 supported by .NET 10 SDK) -->
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(BuildIos)' != 'true'">
		<RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Suppress warnings from transitive SkiaSharp dependency (no patched version available) -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1903;XA0141</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon.svg" Color="#030817" />
		<MauiImage Include="Resources/Images/*.svg" />
		<MauiFont Include="Resources/Fonts/*.ttf" />
		<MauiAsset Include="Resources/Fonts/Inter-OFL.txt" LogicalName="licenses/Inter-OFL.txt" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Transformer" Version="1.11.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

    <ItemGroup>
        <AndroidJavaSource Include="Platforms/Android/Video/SessionVideoExporter.java" Bind="false" />
        <ProguardConfiguration Include="Platforms/Android/Video/session-video.pro" />
    </ItemGroup>

    <!-- Opt-in emulator harness, excluded from regular Debug and all Release builds. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' AND '$(VaultaVideoValidation)' == 'true'">
        <DefineConstants>$(DefineConstants);VAULTA_VIDEO_VALIDATION</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug' AND '$(VaultaVideoValidation)' == 'true'">
        <Compile Include="../../tests/ScannerVideo.Android/ScannerVideoValidationHarness.cs" Link="Validation/ScannerVideoValidationHarness.cs" />
    </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Modules/Identity/Vaulta.Identity.Contracts/Vaulta.Identity.Contracts.csproj" />
		<ProjectReference Include="../Modules/Marketplace/Vaulta.Marketplace.Contracts/Vaulta.Marketplace.Contracts.csproj" />
		<ProjectReference Include="../Modules/Orders/Vaulta.Orders.Contracts/Vaulta.Orders.Contracts.csproj" />
		<ProjectReference Include="../Modules/Payments/Vaulta.Payments.Contracts/Vaulta.Payments.Contracts.csproj" />
		<ProjectReference Include="../Modules/Wallets/Vaulta.Wallets.Contracts/Vaulta.Wallets.Contracts.csproj" />
		<ProjectReference Include="../Vaulta.App.Core/Vaulta.App.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Configuration\appsettings.*.json" />
	</ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug' AND '$(VaultaDevelopmentApiBaseUrl)' != ''">
        <AssemblyMetadata Include="VaultaDevelopmentApiBaseUrl" Value="$(VaultaDevelopmentApiBaseUrl)" />
    </ItemGroup>

</Project>
