<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="DisplayTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.2222" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="H1TextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.2857" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="H2TextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3333" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="H3TextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="TitleTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.4118" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.4667" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="BodySmallTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.5385" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style x:Key="LabelTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3846" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.4545" />
        <Setter Property="TextColor" Value="{DynamicResource TextTertiary}" />
    </Style>
</ResourceDictionary>
