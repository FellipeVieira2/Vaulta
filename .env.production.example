# Copy to .env.production, chmod 600, generate independent random values (openssl rand -hex 32).
# No AWS credentials. No MinIO endpoint. This file is Compose interpolation input, not shell code.
POSTGRES_DB=vaulta
POSTGRES_USER=vaulta
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_ISSUER=vaulta
JWT_AUDIENCE=vaulta-app
ASSETS_BUCKET=vaulta-assets-142767402064-us-east-1
AWS_REGION=us-east-1
DOCKER_SUBNET=172.30.42.0/24
PROXY_GATEWAY=172.30.42.1
# Leave empty until a browser frontend exists. Native MAUI does not need CORS.
CORS_ORIGIN_0=
CORS_ORIGIN_1=
AUTH_PERMIT_LIMIT=20
ASAAS_BASE_URL=https://api.asaas.com/
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
PAYOUTS_TRANSFERS_ENABLED=false
REFUNDS_REQUESTS_ENABLED=false
PAYOUTS_IDENTITY_REVIEWER_USER_ID=
